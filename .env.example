# ---------------------------------------------------------------------------
# Nutri Vision - Back-end (FastAPI)
# Copie este arquivo para `.env` e ajuste os valores. `.env` NAO vai pro git.
# ---------------------------------------------------------------------------

# Aplicacao
PROJECT_NAME="Nutri Vision API"
ENVIRONMENT=development          # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# Banco de dados (PostgreSQL)
POSTGRES_USER=nutrivision
POSTGRES_PASSWORD=nutrivision
POSTGRES_DB=nutrivision
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://nutrivision:nutrivision@localhost:5432/nutrivision

# Banco usado pelos testes automatizados
TEST_DATABASE_URL=sqlite+pysqlite:///:memory:

# Seguranca / JWT (Task 1.2). Em producao, gere a chave com:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=troque-esta-chave-em-producao
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 dias

# Criptografia de dados de saude em repouso (Task 1.6). Chave Fernet. Gere uma
# propria para producao e guarde fora do repositorio:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ATENCAO: perder a chave = perder os dados cifrados. Nao troque a chave de um
# banco que ja tem dados (os valores gravados deixam de abrir).
ENCRYPTION_KEY=khW5PwcdjqnkKxVIr6dlJXX7i2qQv3HH656bD9NcTsU=

# HTTPS (Task 1.6). Em producao, true: redireciona http -> https e envia HSTS.
# Atras de proxy/load balancer que termina o TLS, o proxy precisa mandar
# X-Forwarded-Proto e o uvicorn precisa confiar nele: FORWARDED_ALLOW_IPS=<ip do proxy>
HTTPS_ONLY=false
# FORWARDED_ALLOW_IPS=*

# CORS - lista JSON com as origens do app e do painel web
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8080"]

# Servico de IA (usado a partir da Task 3.1)
AI_SERVICE_URL=http://localhost:8001

# Push de lembretes de refeicao via FCM (Task 2.8). Caminho do JSON da conta de
# servico do Firebase (Console > Configuracoes do projeto > Contas de servico).
# Sem isso o job de lembretes nao envia nada.
# FCM_CREDENTIALS_FILE=/caminho/para/firebase-service-account.json
